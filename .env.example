# Multi-Agent Network Fault Diagnosis System Environment Configuration

# Application Server (Default bound safely to localhost)
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=development
AGENT_TIMEOUT_SECONDS=3.0

# CORS & Security Controls
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
API_AUTH_TOKEN=

# Optional LLM Enhancement (System works 100% deterministically without API keys)
# If provided, LLM outputs are strictly verified against telemetry to prevent hallucinations.
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# Persistence
STORAGE_DIR=data/sessions

